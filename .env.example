# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required: the passcode for the team lead dashboard. Use a long, random value.
ADMIN_PASSCODE=change-me-to-something-long

# Optional: members must enter this code (or open a link with ?team=CODE) before their results are sent.
TEAM_CODE=

# Database (Upstash Redis). Connecting Upstash from the Vercel Marketplace fills these in automatically.
# Either pair works:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional
# MAX_MEMBERS=200
# STORE_PREFIX=teamprint   (the default, kept so data from earlier versions stays visible)
